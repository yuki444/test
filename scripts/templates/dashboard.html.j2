<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>日本株推奨ダッシュボード - {{ date }}</title>
<style>
  :root {
    --bg: #0f1116;
    --panel: #171a21;
    --panel-border: #262b36;
    --text: #e6e8ee;
    --text-dim: #8b93a7;
    --accent: #4f8cff;
    --green: #33c481;
    --red: #ff5c5c;
    --amber: #e8b339;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "Hiragino Sans", "Yu Gothic", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.6;
    padding: 24px 16px 64px;
  }
  .container { max-width: 1100px; margin: 0 auto; }
  h1 { font-size: 1.4rem; margin: 0 0 4px; }
  .subtitle { color: var(--text-dim); font-size: 0.85rem; margin-bottom: 24px; }
  .header-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin-bottom: 32px;
  }
  .stat-card {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 10px;
    padding: 16px;
  }
  .stat-label { color: var(--text-dim); font-size: 0.78rem; margin-bottom: 6px; }
  .stat-value { font-size: 1.5rem; font-weight: 700; }
  .positive { color: var(--green); }
  .negative { color: var(--red); }
  section { margin-bottom: 40px; }
  h2 {
    font-size: 1.05rem;
    border-left: 4px solid var(--accent);
    padding-left: 10px;
    margin-bottom: 14px;
  }
  .table-wrap { overflow-x: auto; border: 1px solid var(--panel-border); border-radius: 10px; }
  table { width: 100%; border-collapse: collapse; min-width: 640px; background: var(--panel); }
  th, td { padding: 10px 12px; text-align: left; font-size: 0.85rem; white-space: nowrap; }
  th { color: var(--text-dim); font-weight: 500; border-bottom: 1px solid var(--panel-border); }
  tbody tr { border-bottom: 1px solid var(--panel-border); }
  tbody tr:last-child { border-bottom: none; }
  .score-bar-track { background: #262b36; border-radius: 4px; width: 100px; height: 8px; overflow: hidden; display: inline-block; vertical-align: middle; margin-right: 8px; }
  .score-bar-fill { background: linear-gradient(90deg, var(--accent), var(--green)); height: 100%; }
  .rank { color: var(--text-dim); }
  .empty { color: var(--text-dim); padding: 20px; text-align: center; }
  .chart-wrap { background: var(--panel); border: 1px solid var(--panel-border); border-radius: 10px; padding: 16px; }
  .reports-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .reports-list a {
    color: var(--accent);
    text-decoration: none;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.82rem;
  }
  .reports-list a:hover { border-color: var(--accent); }
  footer { color: var(--text-dim); font-size: 0.75rem; text-align: center; margin-top: 40px; }
  .reason-cell { max-width: 320px; white-space: normal; color: var(--text-dim); font-size: 0.78rem; }
</style>
</head>
<body>
<div class="container">
  <h1>日本株推奨・自律運用ダッシュボード</h1>
  <div class="subtitle">最終更新: {{ date }}（毎日09:00 JST自動更新・仮想売買シミュレーション）</div>

  <div class="header-stats">
    <div class="stat-card">
      <div class="stat-label">総資産</div>
      <div class="stat-value">¥{{ '{:,.0f}'.format(total_value) }}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">損益（実現+含み）</div>
      <div class="stat-value {{ 'positive' if total_pnl >= 0 else 'negative' }}">
        {{ '+' if total_pnl >= 0 else '' }}¥{{ '{:,.0f}'.format(total_pnl) }}
        ({{ '+' if total_pnl_pct >= 0 else '' }}{{ '%.2f'|format(total_pnl_pct) }}%)
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-label">勝率（決済済み売買）</div>
      <div class="stat-value">{{ '%.1f'|format(win_rate) }}% <span style="font-size:0.8rem;color:var(--text-dim);">({{ win_count }}/{{ sell_count }})</span></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">保有銘柄数</div>
      <div class="stat-value">{{ positions|length }} / 10</div>
    </div>
  </div>

  <section>
    <h2>TOP10 推奨銘柄（本日スコア順）</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>#</th><th>コード</th><th>銘柄名</th><th>スコア</th><th>株価</th><th>前日比</th></tr>
        </thead>
        <tbody>
        {% for s in top10 %}
          <tr>
            <td class="rank">{{ loop.index }}</td>
            <td>{{ s.code }}</td>
            <td>{{ s.name }}</td>
            <td>
              <span class="score-bar-track"><span class="score-bar-fill" style="width: {{ (s.totalScore / max_score * 100) | round(1) }}%;"></span></span>
              {{ '%.1f'|format(s.totalScore) }}pt
            </td>
            <td>¥{{ '{:,.0f}'.format(s.currentPrice) }}</td>
            <td class="{{ 'positive' if s.priceChangePct >= 0 else 'negative' }}">{{ '+' if s.priceChangePct >= 0 else '' }}{{ '%.2f'|format(s.priceChangePct) }}%</td>
          </tr>
        {% else %}
          <tr><td colspan="6" class="empty">データがありません</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>保有ポジション</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>コード</th><th>銘柄名</th><th>株数</th><th>取得単価</th><th>現在価格</th><th>含み損益</th><th>売却ルール</th></tr>
        </thead>
        <tbody>
        {% for p in positions %}
          <tr>
            <td>{{ p.code }}</td>
            <td>{{ p.name }}</td>
            <td>{{ p.shares }}</td>
            <td>¥{{ '{:,.0f}'.format(p.buyPrice) }}</td>
            <td>¥{{ '{:,.0f}'.format(p.currentPrice) }}</td>
            <td class="{{ 'positive' if p.pnl >= 0 else 'negative' }}">{{ '+' if p.pnl >= 0 else '' }}¥{{ '{:,.0f}'.format(p.pnl) }} ({{ '+' if p.pnlPct >= 0 else '' }}{{ '%.1f'|format(p.pnlPct) }}%)</td>
            <td>損切-{{ p.sellRules.stopLoss }}% / 利確+{{ p.sellRules.takeProfit }}% / {{ p.sellRules.daysToHold }}日</td>
          </tr>
        {% else %}
          <tr><td colspan="7" class="empty">保有ポジションはありません</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>資産推移（直近7日）</h2>
    <div class="chart-wrap">
      {{ chart_svg | safe }}
    </div>
  </section>

  <section>
    <h2>売買履歴</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>日付</th><th>銘柄</th><th>売買</th><th>株数</th><th>価格</th><th>理由</th><th>損益</th></tr>
        </thead>
        <tbody>
        {% for t in trade_history %}
          <tr>
            <td>{{ t.date }}</td>
            <td>{{ t.code }} {{ t.name }}</td>
            <td class="{{ 'positive' if t.type == 'buy' else 'negative' }}">{{ '買' if t.type == 'buy' else '売' }}</td>
            <td>{{ t.shares }}</td>
            <td>¥{{ '{:,.0f}'.format(t.price) }}</td>
            <td class="reason-cell">{{ t.reason }}</td>
            <td class="{{ 'positive' if (t.pnl or 0) >= 0 else 'negative' }}">{% if t.pnl is not none %}{{ '+' if t.pnl >= 0 else '' }}¥{{ '{:,.0f}'.format(t.pnl) }}{% endif %}</td>
          </tr>
        {% else %}
          <tr><td colspan="7" class="empty">売買履歴はありません</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>過去のレポート</h2>
    <div class="reports-list">
    {% for r in past_reports %}
      <a href="{{ r.href }}">{{ r.label }}</a>
    {% else %}
      <span class="empty">過去レポートはまだありません</span>
    {% endfor %}
    </div>
  </section>

  <footer>Suno AI Lyrics リポジトリ内で稼働する日本株スコアリング・仮想運用パイプライン（実資金の売買は行いません）</footer>
</div>
</body>
</html>
